{
  "name": "ddia-learning-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "workspaces": [
    "workers/api"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "generate:curriculum": "tsx scripts/generate-curriculum.ts",
    "generate:sql-wasm": "node scripts/copy-sql-wasm.mjs",
    "predev": "npm run generate:curriculum && npm run generate:sql-wasm",
    "prebuild": "npm run generate:curriculum && npm run generate:sql-wasm && npm run validate:content",
    "pretypecheck": "npm run generate:curriculum && npm run validate:content",
    "pretest": "npm run generate:curriculum && npm run validate:content",
    "dev": "next dev",
    "build": "NODE_OPTIONS=\"--import ./scripts/capture-build-uncaught.mjs ${NODE_OPTIONS:-}\" next build",
    "start": "next start",
    "prelint": "npm run validate:content",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "pretest:integration": "npm run generate:curriculum -- --root tests/fixtures/content/valid && npm run validate:content -- --root tests/fixtures/content/valid",
    "test:integration": "bash scripts/test-integration.sh",
    "pretest:workers": "npm run generate:curriculum -- --root tests/fixtures/content/valid && npm run validate:content -- --root tests/fixtures/content/valid",
    "test:workers": "bash scripts/test-workers.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "opennextjs-cloudflare build && node scripts/generate-worker-csp-headers.mjs && opennextjs-cloudflare preview",
    "build:worker": "opennextjs-cloudflare build && node scripts/generate-worker-csp-headers.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:worker-visibility": "node scripts/check-worker-visibility.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@next/mdx": "^15.5.20",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@sentry/browser": "^10.68.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/sql.js": "^1.4.9",
    "dompurify": "^3.4.13",
    "flexsearch": "^0.8.212",
    "framer-motion": "^11.18.2",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.1",
    "jose": "^6.2.3",
    "marked": "^18.0.7",
    "next": "15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-frontmatter": "^5.0.0",
    "sql.js": "^1.14.1",
    "toucan-js": "^4.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "3.2.0",
    "@opennextjs/cloudflare": "1.20.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.2",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.20",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^29.1.1",
    "miniflare": "4.20260730.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.7.2",
    "vitest": "3.2.7",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "js-yaml": "4.3.1"
  }
}
